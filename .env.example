# ---------- App ----------
APP_ENV=development
APP_NAME=rag-app
API_V1_PREFIX=/api/v1
BACKEND_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]

# ---------- PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# ---------- Qdrant Cloud ----------
QDRANT_URL=https://YOUR-CLUSTER.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=document_chunks

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# ---------- Auth ----------
JWT_SECRET_KEY=generate-with-secrets-token_urlsafe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
SESSION_SECRET_KEY=generate-another-one
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---------- Documents / chunking ----------
MAX_UPLOAD_MB=20
ALLOWED_FILE_TYPES=["pdf","txt"]
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---------- Retrieval ----------
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.30
MAX_CONTEXT_CHARS=8000

# ---------- Logging / DB tuning ----------
LOG_LEVEL=INFO
LOG_JSON=false
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------- Auth (Phase 3) ----------
FRONTEND_REDIRECT_URL=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
OAUTH_STATE_TTL_SECONDS=600
REFRESH_REUSE_GRACE_SECONDS=10

# ---------- Tests ----------
TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5433/ragapp_test

# ---------- Processing / worker (Phase 5) ----------
EMBEDDING_BATCH_SIZE=64
MAX_CHUNKS_PER_DOCUMENT=2000
MAX_PDF_PAGES=500
MAX_EXTRACTED_CHARS=5000000
OPENAI_MAX_RETRIES=3
QDRANT_TIMEOUT_SECONDS=30
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=900
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=900

# ---------- RAG answering (Phase 6) ----------
OPENAI_CHAT_MAX_OUTPUT_TOKENS=1000
OPENAI_CHAT_TEMPERATURE=0.2

# ---------- Rate limits, quotas, request limits (Phase 7) ----------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ASK_PER_MINUTE=20
RATE_LIMIT_ASK_PER_HOUR=300
RATE_LIMIT_UPLOAD_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_HOUR=100
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_IP_PER_MINUTE=60
TRUSTED_PROXY_COUNT=0
MAX_DOCUMENTS_PER_USER=200
MAX_REQUEST_BODY_KB=64

# ---------- Storage / deployment (Phase 8) ----------
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
ALLOWED_HOSTS=[]